POSTGRES_USER=linkbook
POSTGRES_PASSWORD=linkbook_local
POSTGRES_DB=linkbook
POSTGRES_PORT=15432
API_PORT=8080
# Публичный origin Web для проверки POST /api/links; должен совпадать с адресом браузера.
PUBLIC_ORIGIN=http://localhost:3000
# Необязательно: адрес API для серверного прокси Next.js (по умолчанию порт API_PORT).
# API_ORIGIN=http://127.0.0.1:8080
# API подключается к базе и автоматически применяет миграции при запуске.
DATABASE_URL=postgres://linkbook:linkbook_local@localhost:15432/linkbook?sslmode=disable
